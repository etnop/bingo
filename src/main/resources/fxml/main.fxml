<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Text?>

<VBox fx:id="main" minHeight="484.0" minWidth="705.0" prefHeight="484.0" prefWidth="705.0" stylesheets="@default.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.pedroponte.Bingo.controllers.MainController">
   <children>
            <Pane prefHeight="484.0" prefWidth="898.0">
               <children>
                  <ImageView fitHeight="252.0" fitWidth="354.0" layoutX="36.0" layoutY="106.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@ellipse21.png" />
                     </image>
                  </ImageView>
            <Pane fx:id="pane_init" layoutX="406.0" layoutY="2.0" prefHeight="484.0" prefWidth="305.0">
               <children>
                        <Button layoutX="26.0" layoutY="134.0" mnemonicParsing="false" onAction="#novo" prefHeight="84.0" prefWidth="247.0" text="Novo" />
                        <Button layoutX="26.0" layoutY="250.0" mnemonicParsing="false" onAction="#gestaoCartoes" prefHeight="84.0" prefWidth="247.0" text="Carregar Jogo" />
               </children>
            </Pane>
            <VBox fx:id="pane_novo" layoutX="709.0" layoutY="40.0" prefWidth="290.0" spacing="10">
               <children>
                  <Label styleClass="panel-title" text="JOGAR COM UMA SESSÃO" />
                  <ComboBox fx:id="sessoes" maxWidth="Infinity" />
                  <Button fx:id="btnJogarSessao" maxWidth="Infinity" prefHeight="56.0" mnemonicParsing="false" onAction="#jogarSessao" text="Abrir sessão" />
                  <Separator />
                  <Label styleClass="panel-title" text="OU GERAR SESSÃO NOVA" />
                  <HBox spacing="8" alignment="CENTER_LEFT">
                     <Label text="Cartões" />
                     <Spinner fx:id="quantidade" editable="true" prefWidth="100.0" />
                  </HBox>
                  <Button maxWidth="Infinity" prefHeight="56.0" mnemonicParsing="false" onAction="#gerarCartoes" text="Gerar sessão" />
               </children>
            </VBox>
               </children>
            </Pane>
   </children>
</VBox>
